    {
      "id": "e9b68add-ec7a-45d8-ab6b-b42cb4f6e3fa",
      "name": "Prepare Inquiry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        230,
        0
      ],
      "parameters": {
        "jsCode": "const { name, email, message } = $input.first().json.body ?? {};\nconst inquiry = { Name: name, Email: email, Message: message };\nconst Name = String(inquiry.Name ?? '').trim();\nconst Email = String(inquiry.Email ?? '').trim();\nconst Message = String(inquiry.Message ?? '').trim();\nif (!Name || !Message || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(Email)) {\n  throw new Error('Enter a name, valid email address and message.');\n}\nreturn [{ json: { Name, Email, Message, 'Received At (UTC)': new Date().toISOString() } }];"
      }
    },
    {
      "id": "c5c8a30d-3115-4fa5-a533-eb6f2636206d",
      "name": "Save to Google Sheet",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "PASTE_APPS_SCRIPT_EXEC_URL_HERE",
        "sendBody": true,
        "options": {},
        "bodyParameters": {
          "parameters": [
            {
              "name": "token",
              "value": "REPLACE_WITH_APPS_SCRIPT_SECRET"
            },
            {
              "name": "Name",
              "value": "={{ $json['Name'] }}"
            },
            {
              "name": "Email",
              "value": "={{ $json['Email'] }}"
            },
            {
              "name": "Message",
              "value": "={{ $json['Message'] }}"
            },
            {
              "name": "Received At (UTC)",
              "value": "={{ $json['Received At (UTC)'] }}"
            }
          ]
        }
      }
    },
    {
      "id": "91ec8266-82e6-44b0-bd8c-353a8b782dd7",
      "name": "Confirm Sheet Save",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        0
      ],
      "parameters": {
        "jsCode": "const result = $input.first().json;\nif (result.ok !== true) throw new Error('Google Sheet save failed: ' + (result.error || 'Unexpected response'));\nreturn [{ json: { saved: true } }];"
      }
    },
    {
      "id": "ac67d9e2-fd6e-4f34-8652-8c80e0b4a49a",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        920,
        0
      ],
      "parameters": {
        "fromEmail": "your-smtp-sender@example.com",
        "toEmail": "={{ $('Prepare Inquiry').first().json.Email }}",
        "subject": "We received your inquiry | Impact Infoways",
        "emailFormat": "text",
        "text": "={{ 'Hi ' + $('Prepare Inquiry').first().json.Name + ',\\n\\nThank you for contacting Impact Infoways. We received your inquiry and will get back to you soon.\\n\\nImpact Infoways' }}",
        "options": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "3c478681-e03b-4175-ace0-78088acdc9be",
