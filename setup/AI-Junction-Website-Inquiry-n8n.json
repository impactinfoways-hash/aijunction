      "name": "Website Inquiry",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "aijunction-inquiry",
        "authentication": "headerAuth",
